# 网关环境变量示例（复制到 /opt/cloudlet-api/.env 并填真实值）
# 切勿提交此文件或 .env 到 git

# ===== 鉴权（必填）=====
# JWT 签名密钥，请用 `openssl rand -hex 32` 生成
JWT_SECRET=<REPLACE_WITH_YOUR_OWN_VALUE>

# 管理后台令牌（与玩家 JWT 体系完全隔离），请用 `openssl rand -hex 16` 生成
ADMIN_TOKEN=<REPLACE_WITH_YOUR_OWN_VALUE>

# ===== 数据湖连接：二选一 =====
# 路A（推荐，直接对接微家事网关 T4 数据层）：填 T4_KEY
#   1. 登录 your-gateway.example.com/admin → 密钥 → 签发密钥（作用域 data:read + data:write）
#   2. 复制 raw_secret 填到下面；T4_BASE 默认即微家事网关，一般不用改
T4_KEY=<REPLACE_WITH_YOUR_OWN_VALUE>
T4_BASE=<REPLACE_WITH_YOUR_OWN_VALUE>

# 路B（原始 cloudflarepool，X-Sync-Key 通道）：填 INTERNAL_KEY
#   仅当不走微家事网关、直连数据湖时才用
INTERNAL_KEY=<REPLACE_WITH_YOUR_OWN_VALUE>
LAKE_BASE=<REPLACE_WITH_YOUR_OWN_VALUE>
LAKE_TENANT=<REPLACE_WITH_YOUR_OWN_VALUE>

# ===== 通用 =====
# 集合（表）名前缀，避免与同数据湖其他应用冲突（一般不用改）
# LAKE_COLLECTION=cloudlet_saves
# LAKE_COLLECTION_ACCOUNTS=cloudlet_accounts
# LAKE_COLLECTION_USERNAMES=cloudlet_usernames

PORT=<REPLACE_WITH_YOUR_OWN_VALUE>
ALLOWED_ORIGIN=<REPLACE_WITH_YOUR_OWN_VALUE>
# PBKDF2_ITER=120000
