# 网关环境变量示例（复制到 /opt/cloudlet-api/.env 并填真实值）
# 切勿提交此文件或 .env 到 git

# ===== 鉴权（必填）=====
# JWT 签名密钥，请用 `openssl rand -hex 32` 生成
JWT_SECRET=<REPLACE_WITH_YOUR_OWN_VALUE>

# 管理后台令牌（与玩家 JWT 体系完全隔离），请用 `openssl rand -hex 16` 生成
ADMIN_TOKEN=<REPLACE_WITH_YOUR_OWN_VALUE>

# ===== 数据湖连接：三选一（至少一个）=====
# 路C（推荐，对接微家事通用网关 /api/t2data 通道）：填 GATEWAY_KEY
#   cloudlet 网关用微家事网关的 Ed25519 私钥为每个玩家签 T2 account JWT，
#   经 your-gateway.example.com/api/t2data 代理到数据湖对应租户（cloudlet_* 集合隔离）。
#   本网关不再直连数据湖、不持有 X-Sync-Key，数据湖凭证收敛到微家事网关一侧。
GATEWAY_KEY=<REPLACE_WITH_YOUR_OWN_VALUE>
GATEWAY_BASE=<REPLACE_WITH_YOUR_OWN_VALUE>
#
#   下面两个是 T2 JWT 的身份声明，没有安全默认值，缺失时网关直接拒绝启动：
#   GATEWAY_APP_ID = 该租户在数据湖 tenants 表里记录的 app_id。
#     配错/缺失 → 数据湖对每条请求返回 403 forbidden: app mismatch，
#     表现为「登录始终失败 + 用户名或密码错误」。cloudlet 租户归属 weijiashi。
#   GATEWAY_AUD = 数据湖域名，必须与上游 JWT aud 校验值完全一致（如 data.example.com）。
#     配错/缺失 → 签发的令牌被上游以 401 bad aud 拒绝，同样表现为登录失败。
GATEWAY_APP_ID=<REPLACE_WITH_YOUR_OWN_VALUE>
GATEWAY_AUD=<REPLACE_WITH_YOUR_OWN_VALUE>

# 路A（直接对接微家事网关 T4 数据层）：填 T4_KEY
#   注意：实测 t4data 通道只认 T4 管理员 JWT（/api/admin/login 邮箱密码换取），
#   不认 data 作用域 API Key，故该路实测不可行，仅保留作回退参考。
T4_KEY=<REPLACE_WITH_YOUR_OWN_VALUE>
T4_BASE=<REPLACE_WITH_YOUR_OWN_VALUE>

# 路B（原始 cloudflarepool，X-Sync-Key 通道）：填 INTERNAL_KEY
#   仅当不走微家事网关、直连数据湖时才用
INTERNAL_KEY=<REPLACE_WITH_YOUR_OWN_VALUE>
LAKE_BASE=<REPLACE_WITH_YOUR_OWN_VALUE>
LAKE_TENANT=<REPLACE_WITH_YOUR_OWN_VALUE>

# ===== 通用 =====
# 集合（表）名前缀，避免与同数据湖其他应用冲突（一般不用改）
# LAKE_COLLECTION=cloudlet_saves
# LAKE_COLLECTION_ACCOUNTS=cloudlet_accounts
# LAKE_COLLECTION_USERNAMES=cloudlet_usernames

# ===== 覆盖前快照（多设备覆盖兜底）=====
# 每次覆盖账号存档前，把旧档存进 LAKE_COLLECTION_HISTORY，可经 /api/admin/saves/{id}/restore 回滚
# LAKE_COLLECTION_HISTORY=cloudlet_saves_history
# 每个账号保留份数
# SAVE_HISTORY_KEEP=12
# 最小快照间隔（毫秒）。自动同步每 60s 一次，设 0 会把历史冲成几分钟
# SAVE_SNAPSHOT_INTERVAL_MS=600000

# ===== 维护开关 =====
# 1 = 冻结云端写入（PUT/DELETE 返回 423），读取不受影响
# CLOUD_READONLY=0

PORT=<REPLACE_WITH_YOUR_OWN_VALUE>
ALLOWED_ORIGIN=<REPLACE_WITH_YOUR_OWN_VALUE>
# PBKDF2_ITER=120000
